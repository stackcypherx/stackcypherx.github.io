---
import Base from '../layouts/Base.astro';
import { recommendations as recs } from '../data/recommendations';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const recommendations = [...recs].sort((a, b) => a.n - b.n);
const strengthClass: Record<string, string> = {
  'Do this': 'chip-lime',
  'Strongly consider': 'chip-signal',
  'Worth thinking about': '',
};
---

<Base
  title="Recommendations"
  eyebrow="Additions beyond the brief"
  heading={`${recommendations.length} recommendations`}
  lede="These go beyond what was asked for. They are judgement calls rather than research findings, several of them are uncomfortable, and recommendations 1 and 13 are the two that determine whether the rest of the plan works."
>
  <div class="wrap">
    <div class="narrow" style="margin-bottom: 2rem">
      <div class="note-box">
        <p class="small" style="margin: 0">
          The original scope was three fields, a portfolio, and a milestone checklist. The roadmap
          delivers that. This page argues about it — where the scope has a structural problem, where
          there is an opportunity in it that is easy to miss, and what is missing entirely.
        </p>
      </div>
    </div>

    <div class="narrow" style="margin-bottom: 2rem">
      <nav class="panel">
        <h4 style="margin: 0 0 0.6rem">Contents</h4>
        <ol class="small" style="margin: 0; padding-left: 1.2rem">
          {recommendations.map((r) => (
            <li style="margin-bottom: 0.25rem">
              <a href={`#rec-${r.n}`}>{r.title}</a>
            </li>
          ))}
        </ol>
      </nav>
    </div>

    <div class="narrow">
      {
        recommendations.map((r) => (
          <article class="rec" id={`rec-${r.n}`}>
            <div class="row" style="gap: 0.55rem">
              <span class="rec-n">{String(r.n).padStart(2, '0')}</span>
              <span class={`chip ${strengthClass[r.strength]}`}>{r.strength}</span>
            </div>
            <h2 style="margin: 0.45rem 0 0; font-size: 1.32rem">{r.title}</h2>
            <p class="rec-claim">{r.claim}</p>
            {r.body.map((para) => <p class="small muted">{para}</p>)}
            <div class="rec-do">
              <b>Do this</b>
              {r.action}
            </div>
          </article>
        ))
      }
    </div>

    <div class="narrow" style="margin-top: 2.5rem">
      <div class="card" style="border-left: 3px solid var(--accent)">
        <h3 style="margin: 0 0 0.5rem">If you only act on four</h3>
        <ol style="margin: 0 0 1rem">
          <li><b>Position as a specialist, not a switcher</b> (13) — more than a decade of carrier operations is the asset. Lead with it.</li>
          <li><b>Spike, do not spread</b> (1) — security as primary, since networks is already your profession rather than a track to study.</li>
          <li><b>Aim at AI × Security</b> (2) — network operations plus security plus agentic AI is a combination almost nobody holds.</li>
          <li><b>The evidence ledger rule</b> (4) — no artifact, no tick. A decade of work nobody can verify is the gap that matters most.</li>
        </ol>
        <div class="row">
          <a class="btn btn-primary" href={`${base}/roadmap`}>Open the roadmap</a>
          <a class="btn" href={`${base}/projects`}>See the project briefs</a>
        </div>
      </div>
    </div>
  </div>
</Base>
