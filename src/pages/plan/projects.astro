---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import { projects } from '../../data/projects';
import { slug } from '../../data/types';

const tiers = ['Flagship', 'Portfolio', 'Starter'] as const;
const trackNames = ['Cyber', 'Networks', 'AI', 'Cross-track'] as const;
const statusBadge: Record<string, string> = {
  planned: '',
  building: 'chip-amber',
  shipped: 'chip-lime',
};
const shipped = projects.filter((p) => p.status === 'shipped').length;
---

<Base
  title="Projects"
  eyebrow="Portfolio briefs"
  heading="Projects"
  lede={`${projects.length} briefs, each with the signals it sends to a hiring manager and concrete acceptance criteria. ${shipped} shipped so far. Repo and live links appear as each one ships. Until then, a project is a plan.`}
>
  <div class="wrap stack-lg">
    <section>
      <div class="note-box">
        <p class="small" style="margin: 0">
          <b>Six pinned repos, maximum.</b> Each with a README containing a screenshot or GIF, a live
          link where applicable, an eval table where relevant, and a "what I would do differently"
          section. Archive everything else. A profile with 40 abandoned repos reads worse than one
          with four finished ones.
        </p>
      </div>
    </section>

    <section data-filter-scope>
      <div class="filters" style="margin-bottom: 1.2rem">
        <input type="search" placeholder="Search projects…" data-filter-search aria-label="Search projects" />
        {trackNames.map((t) => <button class="fchip" data-filter-value={t} aria-pressed="false">{t}</button>)}
      </div>

      {
        tiers.map((tier) => {
          const group = projects.filter((p) => p.tier === tier);
          if (group.length === 0) return null;
          return (
            <div data-filter-container style="margin-bottom: 2rem">
              <SectionHead
                id={slug(tier)}
                title={tier}
                note={
                  tier === 'Flagship'
                    ? 'The ones that change how you are read. Two of these sit where two tracks overlap.'
                    : tier === 'Portfolio'
                      ? 'Solid evidence of specific competence. Fast to build once the foundations are there.'
                      : 'Early wins that also make everything afterwards easier.'
                }
              />
              <div class="stack">
                {
                  group.map((p) => (
                    <div
                      class="card"
                      data-filter-item
                      data-filter-tags={p.track}
                      data-filter-text={`${p.title} ${p.pitch} ${p.stack.join(' ')} ${p.track}`}
                    >
                      <div class="row" style="gap: 0.4rem; margin-bottom: 0.5rem">
                        <span class="chip chip-signal">{p.track}</span>
                        <span class={`chip ${statusBadge[p.status]}`}>{p.status}</span>
                        {p.repo && <a class="tiny" href={p.repo}>repo ↗</a>}
                        {p.live && <a class="tiny" href={p.live}>live ↗</a>}
                      </div>

                      <h3 class="" id={p.id} style="margin: 0 0 0.45rem">{p.title}</h3>
                      <p style="margin: 0 0 1rem; max-width: 88ch">{p.pitch}</p>

                      <div class="grid g2 gap" style="gap: 1.4rem">
                        <div>
                          <h4 class="tiny dim" style="margin-bottom: 0.4rem">
                            What it signals
                          </h4>
                          <ul class="small muted" style="margin: 0; padding-left: 1.15rem">
                            {p.signals.map((s) => <li>{s}</li>)}
                          </ul>
                        </div>
                        <div>
                          <h4 class="tiny dim" style="margin-bottom: 0.4rem">
                            Done when
                          </h4>
                          <ul class="small muted" style="margin: 0 0 0.8rem; padding-left: 1.15rem">
                            {p.done.map((d) => <li>{d}</li>)}
                          </ul>
                          <div class="row">
                            {p.stack.map((s) => <span class="tok tiny">{s}</span>)}
                          </div>
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          );
        })
      }
      <p class="muted" style="text-align: center; padding: 2rem 0; margin-inline: auto" data-filter-empty hidden>No project matches. Clear the search or turn off a track filter.</p>
    </section>
  </div>
</Base>
