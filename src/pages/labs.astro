---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ProgressPanel from '../components/ProgressPanel.astro';
import { site } from '../data/site';
import {
  roomGroups,
  totalRooms,
  thmSearch,
  platforms,
  alternatives,
  oscpList,
  redTeamList,
  difficultyKey,
} from '../data/labs';
import { slug } from '../data/types';

const lanes = Array.from(new Set(platforms.map((p) => p.lane)));
const oscpTotal = oscpList.reduce((n, s) => n + s.machines.length, 0);
const rtTotal = redTeamList.reduce((n, s) => n + s.machines.length, 0);
---

<Base
  title="Labs"
  eyebrow="Hands-on tracker"
  heading="Labs, rooms, and machines"
  lede={`The ${totalRooms}-room free TryHackMe track that starts the cybersecurity path, plus ${oscpTotal} OSCP-style machines and ${rtTotal} post-OSCP red team targets. Tick as you go — progress saves locally.`}
>
  <div class="wrap stack-lg">
    <!-- ------------------------------------------------------------ attribution -->
    <section class="note-box">
      <p class="small" style="margin: 0">
        <b>Source:</b> the room sequence is adapted from the <i>{site.sources.trackerName}</i> — a
        100-day Indonesian bootcamp programme with a 50-room checkpoint before mentored study.
        Credited by name only, and not linked: it is access-restricted course material. Room titles
        are public TryHackMe names; the descriptions here are written for this site. The machine
        lists are LainKusanagi's publicly published OSCP-like and post-OSCP red team lists.
      </p>
    </section>

    <!-- ------------------------------------------------------------- THM track -->
    <section>
      <SectionHead
        id="thm"
        title={`Cyber Security 101 — the ${totalRooms}-room free track`}
        note="Work it in order. The sequence is deliberate: fundamentals before tools, tools before targets. Room links go to TryHackMe's search rather than hardcoded slugs, because THM slugs are not derivable from room titles and a search link always resolves."
      />

      <div class="between" style="margin-bottom: 1rem">
        <div style="flex: 1; min-width: 220px; max-width: 460px">
          <div class="between tiny" style="margin-bottom: 0.3rem">
            <span class="dim">Rooms completed</span>
            <span class="figure" data-figure-for="thm.all">—</span>
          </div>
          <div class="bar thick" data-bar-for="thm.all"><span></span></div>
        </div>
        <p class="tiny dim" style="margin: 0; max-width: 34ch">
          The tracker's checkpoint is 50 rooms — below that, specialising is premature.
        </p>
      </div>

      <div data-filter-scope>
        <div class="filters" style="margin-bottom: 1rem">
          <input type="search" placeholder="Filter rooms — try 'privesc', 'OWASP', 'nmap'…" data-filter-search aria-label="Filter rooms" />
          <span class="tiny dim">{roomGroups.length} topics</span>
        </div>

        {
          roomGroups.map((g) => {
            const gid = `thm.${slug(g.topic)}`;
            return (
              <details class="rgroup" open data-filter-container>
                <summary>
                  <span>{g.topic}</span>
                  <span class="chip">{g.rooms.length}</span>
                  <span class="figure" data-figure-for={gid} data-figure-mode="count">—</span>
                </summary>
                <p class="rwhy">{g.why}</p>
                {g.milestone && <div class="rmile">{g.milestone}</div>}
                {
                  g.rooms.map((r) => {
                    const key = `thm.${slug(r.n)}`;
                    return (
                      <label class="rrow" data-filter-item data-filter-text={`${r.n} ${r.d} ${g.topic}`}>
                        <input type="checkbox" class="box" data-key={key} data-group={`${gid} thm.all`} />
                        <span>
                          <span class="rn">{r.n}</span>
                          <span class="rd" style="display: block">{r.d}</span>
                        </span>
                        <a class="tiny" href={thmSearch(r.n)} rel="noopener" target="_blank">open ↗</a>
                      </label>
                    );
                  })
                }
              </details>
            );
          })
        }
        <p class="muted" style="text-align:center" data-filter-empty hidden style="padding: 2rem 0">No rooms match that filter.</p>
      </div>
    </section>

    <!-- -------------------------------------------------------- paywall fallback -->
    <section>
      <SectionHead
        title="When a room has gone premium"
        note="TryHackMe has moved a number of previously free rooms behind its subscription. These free substitutes cover the same ground — in two cases they are genuinely better than the original."
      />
      <div class="tscroll">
        <table>
          <thead><tr><th>Instead of</th><th>Use</th></tr></thead>
          <tbody>
            {alternatives.map((a) => (
              <tr>
                <td class="muted">{a.instead}</td>
                <td><a href={a.use.startsWith('http') ? a.use : a.url}>{a.use}</a> ↗</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ------------------------------------------------------------- platforms -->
    <section>
      <SectionHead
        id="platforms"
        title="Practice platforms"
        note="The tracker's guidance: do not open this section until you have finished at least 50 rooms plus the web block. Breadth too early is how people end up with 400 half-solved boxes and no depth."
      />
      <div data-filter-scope>
        <div class="filters" style="margin-bottom: 1rem">
          <input type="search" placeholder="Filter platforms…" data-filter-search aria-label="Filter platforms" />
          {lanes.map((l) => (
            <button class="fchip" data-filter-value={l} aria-pressed="false">{l}</button>
          ))}
        </div>
        <div class="grid g3 gap">
          {
            platforms.map((p) => (
              <div class="card card-i spot" data-filter-item data-filter-tags={p.lane} data-filter-text={`${p.name} ${p.note} ${p.lane}`}>
                <div class="row" style="gap: 0.4rem">
                  <span class="chip">{p.lane}</span>
                  <span class={`chip ${p.cost === 'Free' ? 'chip-lime' : p.cost === 'Paid' ? 'chip-amber' : ''}`}>{p.cost}</span>
                </div>
                <h3 style="margin: 0.6rem 0 0.3rem; font-size: 1rem">
                  <a href={p.url} rel="noopener">{p.name} ↗</a>
                </h3>
                <p class="small muted" style="margin: 0">{p.note}</p>
              </div>
            ))
          }
        </div>
        <p class="muted" style="text-align:center" data-filter-empty hidden style="padding: 2rem 0">Nothing matches that filter.</p>
      </div>
    </section>

    <!-- ----------------------------------------------------------- OSCP machines -->
    <section>
      <SectionHead
        id="oscp"
        title={`OSCP-style machines (${oscpTotal})`}
        note="LainKusanagi's curated list, as carried in the tracker. The rule that makes this work: no walkthrough on the first attempt, and every box gets notes even when you fail. Target 40 before booking the exam."
      />

      <div class="between" style="margin-bottom: 1rem">
        <div style="flex: 1; min-width: 220px; max-width: 460px">
          <div class="between tiny" style="margin-bottom: 0.3rem">
            <span class="dim">Machines rooted</span>
            <span class="figure" data-figure-for="oscp.all">—</span>
          </div>
          <div class="bar thick" data-bar-for="oscp.all"><span></span></div>
        </div>
        <div class="row tiny dim">
          {difficultyKey.map(([k, v]) => <span><b class="mono">{k}</b> {v}</span>)}
        </div>
      </div>

      <div class="stack">
        {
          oscpList.map((set) => {
            const sid = `oscp.${slug(set.platform + '-' + set.category)}`;
            return (
              <div class="card">
                <div class="between" style="margin-bottom: 0.8rem">
                  <div>
                    <b>{set.platform}</b>
                    <span class="dim"> — {set.category}</span>
                  </div>
                  <span class="figure" data-figure-for={sid} data-figure-mode="count">—</span>
                </div>
                <div class="mgrid">
                  {set.machines.map((m) => (
                    <label class="m">
                      <input type="checkbox" class="box" data-key={`m.${slug(set.platform)}.${slug(m.n)}`} data-group={`${sid} oscp.all`} />
                      <span>{m.n}</span>
                      {m.d && <span class="d">{m.d}</span>}
                    </label>
                  ))}
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- ------------------------------------------------------------- red team -->
    <section>
      <SectionHead
        id="redteam"
        title={`Post-OSCP red team machines (${rtTotal})`}
        note="Beyond OSCP scope: advanced Active Directory, assumed-breach scenarios, OSINT, evasion, command and control, client-side attacks. Do not start these before the OSCP list — they assume the fundamentals are automatic."
      />

      <div style="max-width: 460px; margin-bottom: 1rem">
        <div class="between tiny" style="margin-bottom: 0.3rem">
          <span class="dim">Red team machines</span>
          <span class="figure" data-figure-for="rt.all">—</span>
        </div>
        <div class="bar thick" data-bar-for="rt.all"><span></span></div>
      </div>

      <div class="stack">
        {
          redTeamList.map((set) => {
            const sid = `rt.${slug(set.platform + '-' + set.category)}`;
            return (
              <div class="card">
                <div class="between" style="margin-bottom: 0.8rem">
                  <div>
                    <b>{set.platform}</b>
                    <span class="dim"> — {set.category}</span>
                  </div>
                  <span class="figure" data-figure-for={sid} data-figure-mode="count">—</span>
                </div>
                <div class="mgrid">
                  {set.machines.map((m) => (
                    <label class="m">
                      <input type="checkbox" class="box" data-key={`rtm.${slug(set.platform)}.${slug(m.n)}`} data-group={`${sid} rt.all`} />
                      <span>{m.n}</span>
                    </label>
                  ))}
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    <section><ProgressPanel /></section>

    <section>
      <div class="note-box warn">
        <h3 style="margin: 0 0 0.4rem">Scope discipline</h3>
        <p class="small" style="margin: 0">
          Everything on this page is a deliberately vulnerable, legally provided target. Techniques
          learned here are only legal against systems you own or are explicitly authorised to test —
          that authorisation is in writing, with a defined scope, before you scan anything. Practising
          on something outside that boundary ends careers rather than starting them.
        </p>
      </div>
    </section>
  </div>
</Base>
