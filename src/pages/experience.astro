---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { profile, yearsExperience } from '../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const companies = new Set(profile.experience.map((e) => e.company)).size;
const rail = [
  ['Summary', 'summary'],
  ['Experience', 'experience'],
  ['Engineering cases', 'cases'],
  ['Field record', 'record'],
  ['Credentials', 'credentials'],
  ['Skills', 'skills'],
  ['Education', 'education'],
  ['Contact', 'contact'],
];
const scopeChip: Record<string, string> = {
  International: 'chip-signal',
  'International + national programme': 'chip-signal',
  National: 'chip-violet',
  Standards: 'chip-amber',
};
---

<Base
  title="Experience"
  eyebrow={profile.headline}
  heading={profile.name}
  lede={profile.pitch}
  display
>
  <div slot="hero-extra" class="row" style="margin-top: 2rem; gap: 0.6rem" data-reveal="220">
    <span class="tok">{profile.location}</span>
    <span class="tok">Open to: {profile.openTo}</span>
  </div>

  <div class="wrap" style="margin-top: 3.5rem">
    <div class="railed">
      <nav class="rail" aria-label="On this page">
        <div class="tag" style="margin-bottom: 0.6rem">Contents</div>
        {rail.map(([label, id]) => <a href={`#${id}`}>{label}</a>)}
        <a class="btn btn-sm" style="margin-top: 1.2rem; width: 100%; justify-content: center" href={`${base}/agentic`}>
          Software built →
        </a>
      </nav>

      <div class="stack-lg">
        <!-- ───────────────────────────────────────────────────── summary -->
        <section>
          <div class="grid g4" style="border-block: 1px solid var(--rule); margin-bottom: 2rem">
            <div class="card" data-reveal>
              <div class="stat"><span class="n" data-count={yearsExperience}>0</span><span class="l">Years</span></div>
            </div>
            <div class="card" data-reveal="50">
              <div class="stat"><span class="n" data-count={companies}>0</span><span class="l">Operators</span></div>
            </div>
            <div class="card" data-reveal="100">
              <div class="stat"><span class="n" data-count="4">0</span><span class="l">Provinces</span></div>
            </div>
            <div class="card" data-reveal="150">
              <div class="stat"><span class="n" data-count={profile.credentials.length}>0</span><span class="l">Credentials</span></div>
            </div>
          </div>

          <div id="summary" class="card spot" data-reveal style="border-color: var(--rule-2)">
            {profile.summary.map((p) => <p class="muted" style="max-width: 88ch">{p}</p>)}
          </div>
        </section>

        <!-- ────────────────────────────────────────────────── experience -->
        <section>
          <SectionHead
            id="experience"
            label="Track record"
            title="Professional experience"
            note="Reverse chronological. Scope stated in industry-standard terms rather than internal acronyms, so it reads the same to someone who has never heard of the employer."
          />
          <div class="xp">
            {
              profile.experience.map((job, i) => (
                <article class={`xp-item ${job.current ? 'now' : ''}`} data-reveal={String(Math.min(i * 50, 200))}>
                  <div class="row" style="gap: 0.5rem">
                    {job.current && <span class="chip chip-lime">Current</span>}
                    <span class="tag">{job.period}</span>
                    <span class="tag">{job.place}</span>
                  </div>
                  <h3 class="xp-role">{job.role}</h3>
                  <div class="xp-co">{job.company}</div>
                  {job.companyNote && <div class="tiny dim" style="margin-top: 0.2rem">{job.companyNote}</div>}

                  <p class="small muted" style="margin: 0.9rem 0; max-width: 88ch">
                    <span class="tag" style="display: block; margin-bottom: 0.25rem">Scope</span>
                    {job.scope}
                  </p>

                  <ul class="small muted" style="max-width: 88ch; margin-bottom: 1rem">
                    {job.points.map((p) => <li>{p}</li>)}
                  </ul>

                  <div class="row">{job.tags.map((t) => <span class="tok tiny">{t}</span>)}</div>
                </article>
              ))
            }
          </div>
        </section>

        <!-- ─────────────────────────────────────────────── engineering -->
        <section>
          <SectionHead
            id="cases"
            label="What the work was"
            title="Engineering cases"
            note="Stated so an outsider can judge the difficulty, not so an insider can recognise the project code."
          />
          <div class="grid g3" style="border-block: 1px solid var(--rule)">
            {
              profile.keyProjects.map((p, i) => (
                <div class="card spot" data-reveal={String(i * 60)}>
                  <div class="tag" style="margin-bottom: 0.5rem">{p.period} · {p.place}</div>
                  <h3 style="margin-bottom: 0.5rem">{p.title}</h3>
                  <p class="small muted" style="margin: 0">{p.detail}</p>
                </div>
              ))
            }
          </div>
        </section>

        <!-- ──────────────────────────────────────────────── field record -->
        <section>
          <SectionHead
            id="record"
            label="Verifiable outcomes"
            title="Field record"
            note="Named national infrastructure, documented incidents, a competitive government programme — things an outside reader can weigh without knowing the company."
          />
          <div class="stack">
            {
              profile.achievements.map((a, i) => (
                <div class="card spot" data-reveal={String(Math.min(i * 45, 180))}>
                  <div class="between" style="align-items: flex-start; margin-bottom: 0.5rem">
                    <h3 style="margin: 0; max-width: 62ch">{a.title}</h3>
                    <span class="chip chip-signal">{a.date}</span>
                  </div>
                  <div class="tag" style="margin-bottom: 0.65rem">{a.org}</div>
                  <p class="small muted" style="margin: 0; max-width: 90ch">{a.detail}</p>
                </div>
              ))
            }
          </div>
        </section>

        <!-- ───────────────────────────────────────────────── credentials -->
        <section>
          <SectionHead
            id="credentials"
            label="Independently verifiable"
            title="Certifications"
            note="Issued by bodies a stranger can check. Internal company training is deliberately not listed — it means nothing outside the building."
          />
          <div class="tscroll" data-reveal>
            <table>
              <thead>
                <tr><th>Credential</th><th>Issuer</th><th>Recognition</th><th>Domain</th><th>Earned</th></tr>
              </thead>
              <tbody>
                {
                  profile.credentials.map((c) => (
                    <tr>
                      <td>
                        <b>{c.name}</b>
                        {c.level && <span class="chip chip-lime" style="margin-left: 0.45rem">{c.level}</span>}
                      </td>
                      <td class="muted">{c.issuer}</td>
                      <td><span class={`chip ${scopeChip[c.scope] ?? ''}`}>{c.scope}</span></td>
                      <td class="dim">{c.domain}</td>
                      <td class="mono tiny dim nowrap">{c.date}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="small" style="margin-top: 1rem">
            <a href={`${base}/certifications`} >What's targeted next, and what's deliberately skipped →</a>
          </p>
        </section>

        <!-- ────────────────────────────────────────────────────── skills -->
        <section>
          <SectionHead id="skills" label="Capability" title="Skills" />
          <div class="grid g2" style="border-block: 1px solid var(--rule)">
            {
              profile.skills.map((g, i) => (
                <div class="card spot" data-reveal={String(i * 50)}>
                  <div class="tag tag-signal" style="margin-bottom: 0.75rem">{g.group}</div>
                  <div class="row">{g.items.map((s) => <span class="tok tiny">{s}</span>)}</div>
                </div>
              ))
            }
          </div>
        </section>

        <!-- ────────────────────────────────────────── education / languages -->
        <section>
          <SectionHead id="education" label="Background" title="Education, languages & outside work" />
          <div class="grid g2 gap" style="gap: 1rem">
            <div class="card" data-reveal>
              {
                profile.education.map((e) => (
                  <>
                    <div class="tag" style="margin-bottom: 0.5rem">{e.period}</div>
                    <h3 style="margin-bottom: 0.3rem">{e.award}</h3>
                    <div class="xp-co">{e.school}</div>
                    <div class="tiny dim" style="margin: 0.25rem 0 0.8rem">{e.place} · {e.note}</div>
                    <p class="small muted" style="margin: 0">{e.detail}</p>
                  </>
                ))
              }
              <div style="margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px solid var(--rule)">
                <div class="tag" style="margin-bottom: 0.6rem">Languages</div>
                {
                  profile.languages.map((l) => (
                    <div class="between small" style="padding: 0.28rem 0">
                      <b>{l.name}</b><span class="muted">{l.level}</span>
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="card" data-reveal="80">
              <div class="tag" style="margin-bottom: 0.8rem">Outside the job</div>
              {
                profile.interests.map((i) => (
                  <div style="margin-bottom: 1rem">
                    <b class="small">{i.title}</b>
                    <p class="small muted" style="margin: 0.15rem 0 0">{i.detail}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </section>

        <!-- ───────────────────────────────────────────────────── contact -->
        <section>
          <div id="contact" class="card spot" data-reveal style="border-color: var(--rule-2)">
            <div class="tag tag-signal" style="margin-bottom: 0.6rem">Availability</div>
            <h2 style="margin-bottom: 0.7rem">Open to the right move</h2>
            <p class="muted" style="max-width: 76ch">
              Security engineering, detection engineering, network security and NetDevOps — remote-first
              globally, or relocation to the EU/UK, US, Middle East and APAC.
            </p>
            <div class="row" style="margin-top: 1.4rem">
              <a class="btn btn-primary" href={`mailto:${profile.contact.email}`}>Email</a>
              <a class="btn" href={profile.contact.linkedin}>LinkedIn ↗</a>
              <a class="btn" href={profile.contact.github}>GitHub ↗</a>
              <a class="btn" href={profile.contact.tryhackme}>TryHackMe ↗</a>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</Base>
