---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { profile, yearsExperience, yearsWord } from '../data/profile';
import { tracks } from '../data/roadmap';
import { countItems } from '../data/types';
import { builds } from '../data/vibe';
import type { BgKey } from '../data/backgrounds';

// Home is the hiring-facing summary: who, track record, evidence, contact.
// The learning plan has its own section under /plan and gets one block here.

type NoteFrontmatter = { title: string; description?: string; date: string; track?: string; draft?: boolean };
const allNotes = Object.values(
  import.meta.glob<{ frontmatter: NoteFrontmatter; url?: string }>('./writing/*.md', { eager: true }),
)
  .filter((m) => m.frontmatter && !m.frontmatter.draft && m.url)
  .sort((a, b) => +new Date(b.frontmatter.date) - +new Date(a.frontmatter.date));
const notes = allNotes.slice(0, 3);
const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const securityCreds = profile.credentials.filter((c) => c.domain === 'Security');
const totalMilestones = tracks.reduce((n, t) => n + countItems(t), 0);

// The console home screen: one icon per destination. Section icons show their
// page's photo; build icons show a monogram until each build has a screenshot.
type ConsoleItem = {
  id: string; label: string; kicker: string; line: string;
  cta: string; href: string; bg: BgKey; photo: boolean; mono?: string;
};
// First word of the build's name: short enough for the icon, readable on touch screens.
const monogram = (t: string) => t.split(/[\s-]+/)[0].replace(/[^A-Za-z]/g, '');
// A short intro for the first screen; the full pitch is on the Experience page.
const intro = `${yearsWord[0].toUpperCase()}${yearsWord.slice(1)} years running carrier network and service operations across eastern Indonesia, now specialising into cybersecurity and agentic AI. CEH and Cisco CyberOps certified.`;
const items: ConsoleItem[] = [
  { id: 'experience', label: 'Experience', kicker: `${yearsExperience} years · ${profile.experience.length} roles`, bg: 'field', photo: true,
    line: 'Carrier network and service operations across eastern Indonesia: roles, engineering cases, field record and credentials.',
    cta: 'Open experience', href: '/experience' },
  { id: 'work', label: 'Work', kicker: `${builds.length} builds`, bg: 'work', photo: true,
    line: 'Software I ship by orchestrating coding agents, and the method that keeps it correct.',
    cta: 'See the builds', href: '/work' },
  { id: 'writing', label: 'Writing', kicker: `${allNotes.length} published`, bg: 'writing', photo: true,
    line: 'Technical writeups and notes from the labs and the job.',
    cta: 'Read the writing', href: '/writing' },
  { id: 'plan', label: 'Learning plan', kicker: `${totalMilestones} milestones · ${tracks.length} tracks`, bg: 'lab', photo: true,
    line: 'The open plan behind the move into security and agentic AI. Anyone can use it.',
    cta: 'Open the plan', href: '/plan' },
  ...builds.slice(0, 3).map((b): ConsoleItem => ({
    id: `build-${b.id}`, label: b.title, kicker: `${b.kind} · ${b.period}`, bg: 'work', photo: false, mono: monogram(b.title),
    line: b.summary, cta: 'See this build', href: `/work#${b.id}`,
  })),
];
const sectionCount = 4;
---

<Base sharpBg>
  <!-- ─────────────────────────────────────────────── console home screen -->
  <section class="console" data-console aria-label="Introduction">
    <div class="wrap">
      <ul class="icons" data-icons aria-label="Where to go">
        {items.map((it, i) => (
          <>
            {i === sectionCount && <li class="icons-gap" aria-hidden="true"></li>}
            <li>
              <a
                class={`icon${it.photo ? ' icon-photo' : ''}`}
                href={`${base}${it.href}`}
                data-item={it.id}
                data-bg={it.bg}
                aria-label={it.label}
                aria-describedby={`panel-line-${it.id}`}
                style={it.photo ? `background-image: var(--bg-${it.bg})` : undefined}
              >{it.photo ? it.label : it.mono}</a>
            </li>
          </>
        ))}
      </ul>

      <div class="console-panel">
        <div data-panel="intro">
          <p class="console-kicker">{profile.location} · open to remote work and relocation</p>
          <h1 class="console-title">I keep carrier networks running. Now I'm securing them.</h1>
          <p class="lede console-line">{intro}</p>
          <div class="console-actions">
            <a class="btn btn-primary btn-pill" href={`${base}/experience`}>Open experience</a>
            <a class="btn btn-pill" href={`mailto:${profile.contact.email}`}>Email me</a>
            <a class="btn btn-pill" href={profile.contact.linkedin}>LinkedIn ↗</a>
          </div>
        </div>
        {items.map((it) => (
          <div data-panel={it.id} hidden>
            <p class="console-kicker">{it.kicker}</p>
            <p class="console-title">{it.label}</p>
            <p class="lede console-line" id={`panel-line-${it.id}`}>{it.line}</p>
            <div class="console-actions">
              <a class="btn btn-primary btn-pill" href={`${base}${it.href}`} tabindex="-1">{it.cta}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="wrap stack-lg" style="margin-top: 2rem">
    <!-- ───────────────────────────────────────────────────────── position -->
    <section>
      <SectionHead label="Position" title="Not a career change. A specialisation." />
      <div class="grid g2 gap" style="gap: 1.1rem">
        <div class="card">
          <div class="tag tag-signal" style="margin-bottom: 0.6rem">What I already do</div>
          <p class="small muted" style="margin: 0">
            {yearsExperience} years in telecom operations. Today I own mobile broadband and transport
            service operations across Papua, Maluku, Sulawesi and Kalimantan: fibre and FTTH,
            Metro-Ethernet, IP core and backhaul, DWDM. SLA accountability for wholesale and enterprise
            customers, incident command when it breaks, and root-cause analysis on the faults that keep
            coming back.
          </p>
        </div>
        <div class="card">
          <div class="tag tag-signal" style="margin-bottom: 0.6rem">Where it's going</div>
          <p class="small muted" style="margin: 0">
            Network operations is where security incidents get detected and contained, and I have spent
            a decade watching how carrier infrastructure behaves when it fails. I hold CEH and Cisco
            CyberOps Associate, and I'm building toward network and telecom security, detection
            engineering, and securing agentic AI systems.
          </p>
        </div>
      </div>
    </section>

    <!-- ───────────────────────────────────────────────────── track record -->
    <section>
      <SectionHead
        label="Track record"
        title="Experience"
        note="The short version. Scope, responsibilities and engineering cases are on the full experience page."
      />
      <ol class="tl">
        {
          profile.experience.map((job) => (
            <li>
              <div class="tag">{job.period}</div>
              <h3 style="margin: 0; font-size: 1.15rem">{job.role}</h3>
              <div class="small" style="font-weight: 600">
                {job.company}
                {job.current && <span class="chip chip-lime" style="margin-left: 0.5rem">Current</span>}
              </div>
              <p class="small muted" style="margin: 0.2rem 0 0; max-width: 80ch">{job.scope}</p>
            </li>
          ))
        }
      </ol>
      <p class="small" style="margin-top: 1.2rem">
        <a href={`${base}/experience`}>Full experience, engineering cases and skills</a>
      </p>
    </section>

    <!-- ──────────────────────────────────────────────────── field record -->
    <section>
      <SectionHead
        label="Field record"
        title="Work an outsider can check"
        note="Named infrastructure and real incidents, rather than internal awards."
      />
      <div class="stack">
        {
          profile.achievements.slice(0, 3).map((a) => (
            <article class="card bordered">
              <div class="row" style="gap: 0.5rem; margin-bottom: 0.3rem">
                <span class="tag">{a.date}</span>
                <span class="tag">{a.org}</span>
              </div>
              <h3 style="margin: 0 0 0.4rem">{a.title}</h3>
              <p class="small muted" style="margin: 0; max-width: 88ch">{a.detail}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ──────────────────────────────────────────────────────── build work -->
    <section>
      <SectionHead
        label="Agentic engineering"
        title="Software I ship by orchestrating agents"
        note={`${builds.length} systems in four months: an internal operations analytics platform, alerting bots, document automation, two published sites. The specification, the structure and the review are mine; the typing is not.`}
      />
      <div class="grid g3 gap" style="gap: 1rem">
        {
          builds.slice(0, 3).map((b) => (
            <a class="card card-i" href={`${base}/work#${b.id}`}
               style="display: flex; flex-direction: column; gap: 0.6rem">
              <div class="row" style="gap: 0.4rem">
                <span class="chip chip-signal">{b.kind}</span>
                <span class="tag">{b.period}</span>
              </div>
              <h3 style="margin: 0">{b.title}</h3>
              <p class="small muted" style="flex: 1; margin: 0">{b.summary}</p>
              <div class="row">{b.stack.slice(0, 4).map((s) => <span class="tok tiny">{s}</span>)}</div>
            </a>
          ))
        }
      </div>
      <p class="small" style="margin-top: 1.2rem"><a href={`${base}/work`}>All {builds.length} builds, with the method behind them</a></p>
    </section>

    <!-- ───────────────────────────────────────────────────── credentials -->
    <section>
      <SectionHead label="Credentials" title="Security credentials held" />
      <div class="tscroll">
        <table>
          <thead><tr><th>Credential</th><th>Issuer</th><th>Earned</th></tr></thead>
          <tbody>
            {securityCreds.map((c) => (
              <tr>
                <td><b>{c.name}</b>{c.level && <span class="small muted"> · {c.level}</span>}</td>
                <td class="muted">{c.issuer}</td>
                <td class="mono tiny nowrap">{c.date}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small" style="margin-top: 1.2rem">
        <a href={`${base}/experience#credentials`}>All credentials and education</a>
      </p>
    </section>

    <!-- ─────────────────────────────────────────────────────────── writing -->
    {
      notes.length > 0 && (
        <section>
          <SectionHead label="Writing" title="Latest writing" />
          <div class="stack">
            {notes.map((n) => (
              <a class="card card-i bordered" href={n.url} style="display: block; color: inherit">
                <div class="row" style="gap: 0.5rem; margin-bottom: 0.3rem">
                  <time class="tiny dim mono" datetime={n.frontmatter.date}>{fmt(n.frontmatter.date)}</time>
                  {n.frontmatter.track && <span class="chip chip-signal">{n.frontmatter.track}</span>}
                </div>
                <h3 style="margin: 0 0 0.3rem">{n.frontmatter.title}</h3>
                {n.frontmatter.description && <p class="small muted" style="margin: 0">{n.frontmatter.description}</p>}
              </a>
            ))}
          </div>
          <p class="small" style="margin-top: 1.2rem"><a href={`${base}/writing`}>All writing</a></p>
        </section>
      )
    }

    <!-- ─────────────────────────────────────────────── learning in public -->
    <section>
      <SectionHead
        label="Learning in public"
        title="The plan behind the specialisation"
        note={`${totalMilestones} milestones across ${tracks.length} tracks, each tied to a public artifact it has to produce. The roadmap, lab tracker and reasoning are open for anyone to use.`}
      />
      <p class="small" style="margin: 0"><a href={`${base}/plan`}>Open the learning plan</a></p>
    </section>

    <!-- ────────────────────────────────────────────────────────── contact -->
    <section>
      <div class="card" style="border-color: var(--rule-2)">
        <div class="tag tag-signal" style="margin-bottom: 0.6rem">Availability</div>
        <h2 style="margin-bottom: 0.7rem">Open to the right move</h2>
        <p class="muted" style="max-width: 76ch">
          Security engineering, detection engineering, network security and NetDevOps. Open to: {profile.openTo}.
        </p>
        <div class="row" style="margin-top: 1.4rem">
          <a class="btn btn-primary" href={`mailto:${profile.contact.email}`}>Email me</a>
          <a class="btn" href={profile.contact.linkedin}>LinkedIn ↗</a>
          <a class="btn" href={profile.contact.github}>GitHub ↗</a>
        </div>
      </div>
    </section>
  </div>

</Base>
