---
import Base from '../layouts/Base.astro';
import TrackCard from '../components/TrackCard.astro';
import SectionHead from '../components/SectionHead.astro';
import { profile, yearsExperience } from '../data/profile';
import { tracks, timeline, cadence } from '../data/roadmap';
import { countItems, itemKey } from '../data/types';
import { totalRooms } from '../data/labs';
import { builds, vibeStats } from '../data/vibe';
import { certs } from '../data/certs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const totalMilestones = tracks.reduce((n, t) => n + countItems(t), 0);
const held = certs.filter((c) => c.held).length;
const stack = Array.from(new Set(builds.flatMap((b) => b.stack)));
const domains = profile.skills.find((s) => s.group === 'Network & telecom')?.items ?? [];
const ticker = [...domains, ...stack.slice(0, 14)];
---

<Base
  eyebrow={`${profile.location} · open to relocation`}
  heading="I keep carrier networks running. Now I'm securing them."
  lede={profile.pitch}
  canvas
  display
>
  <div slot="hero-extra" class="row" style="margin-top: 2.2rem; gap: 0.75rem" data-reveal="220">
    <a class="btn btn-primary" href={`${base}/experience`}>Experience</a>
    <a class="btn" href={`${base}/agentic`}>What I've built</a>
    <a class="btn" href={profile.contact.linkedin}>LinkedIn ↗</a>
  </div>

  <div class="wrap stack-lg" style="margin-top: 4rem">
    <!-- ─────────────────────────────────────────────────────── key numbers -->
    <section>
      <div class="grid g4" style="border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: var(--line)">
        <div class="card" data-reveal>
          <div class="stat"><span class="n" data-count={yearsExperience}>0</span><span class="l">Years in telecom</span></div>
          <p class="tiny dim" style="margin-top: 0.5rem">Access, transport, IP core, mobile</p>
        </div>
        <div class="card" data-reveal="60">
          <div class="stat"><span class="n" data-count="4">0</span><span class="l">Provinces covered</span></div>
          <p class="tiny dim" style="margin-top: 0.5rem">Papua · Maluku · Sulawesi · Kalimantan</p>
        </div>
        <div class="card" data-reveal="120">
          <div class="stat"><span class="n" data-count={builds.length}>0</span><span class="l">Systems shipped</span></div>
          <p class="tiny dim" style="margin-top: 0.5rem">Agent-built · {vibeStats.activeDays} active days</p>
        </div>
        <div class="card" data-reveal="180">
          <div class="stat"><span class="n">CEH</span><span class="l">+ CyberOps</span></div>
          <p class="tiny dim" style="margin-top: 0.5rem">{held} security credentials held</p>
        </div>
      </div>
    </section>

    <!-- ─────────────────────────────────────────────────────────── ticker -->
    <section>
      <div class="marquee" aria-hidden="true">
        <div class="marquee-t">
          {ticker.map((s) => <span>{s}</span>)}
          {ticker.map((s) => <span>{s}</span>)}
        </div>
      </div>
    </section>

    <!-- ───────────────────────────────────────────────────────── the pitch -->
    <section>
      <SectionHead label="Position" title="Not a career change. A specialisation." />
      <div class="grid g2 gap" style="gap: 1.1rem">
        <div class="card spot" data-reveal>
          <div class="tag tag-signal" style="margin-bottom: 0.6rem">What I already do</div>
          <p class="small muted" style="margin: 0">
            Own mobile broadband and transport service operations across roughly the eastern half of
            Indonesia. Fibre and FTTH, Metro-Ethernet, IP core and backhaul, DWDM. SLA accountability
            for wholesale and enterprise customers, incident command when it breaks, and root-cause
            analysis on the faults that keep coming back.
          </p>
        </div>
        <div class="card spot" data-reveal="80">
          <div class="tag tag-signal" style="margin-bottom: 0.6rem">Where it's going</div>
          <p class="small muted" style="margin: 0">
            Network operations is where security incidents are actually detected and contained.
            Knowing how carrier infrastructure genuinely behaves is context most security candidates
            never get. I'm building toward network and telecom security, detection engineering, and
            securing agentic AI systems — the overlap almost nobody occupies.
          </p>
        </div>
      </div>
    </section>

    <!-- ──────────────────────────────────────────────────────── build work -->
    <section>
      <SectionHead
        label="Agentic engineering"
        title="I ship software by orchestrating agents"
        note="Six systems in four months — an internal operations analytics platform, alerting bots, document automation, two published sites. The specification, the structure and the review are mine; the typing is not."
      />
      <div class="grid g3 gap" style="gap: 1rem">
        {
          builds.slice(0, 3).map((b, i) => (
            <a class="card card-i spot" href={`${base}/agentic#${b.id}`} data-reveal={String(i * 70)}
               style="display: flex; flex-direction: column; gap: 0.6rem">
              <div class="row" style="gap: 0.4rem">
                <span class="chip chip-signal">{b.kind}</span>
                <span class="tag">{b.period}</span>
              </div>
              <h3 style="margin: 0">{b.title}</h3>
              <p class="small muted" style="flex: 1; margin: 0">{b.summary}</p>
              <div class="row">{b.stack.slice(0, 4).map((s) => <span class="tok tiny">{s}</span>)}</div>
            </a>
          ))
        }
      </div>
      <p class="small" style="margin-top: 1.2rem"><a href={`${base}/agentic`} style="color: var(--signal)">All six builds, with method →</a></p>
    </section>

    <!-- ────────────────────────────────────────────────────────── roadmap -->
    <section>
      <SectionHead
        label="In progress"
        title="The specialisation plan, in public"
        note={`${totalMilestones} milestones across four tracks. Every one names the public artifact it has to produce before it counts — the progress bars are live and deliberately not flattering.`}
      />
      <div class="grid g4 gap" style="gap: 1rem">
        {tracks.map((t) => <TrackCard track={t} />)}
      </div>
      <div class="note-box" style="margin-top: 1.4rem" data-reveal>
        <p class="small" style="margin: 0">
          The phase windows assume someone starting from zero. I'm not —
          <a href={`${base}/roadmap#starting-position`} style="color: var(--signal)">see what's already covered and what the real gaps are</a>.
        </p>
      </div>
    </section>

    <!-- ───────────────────────────────────────────────────────── timeline -->
    <section>
      <SectionHead id="timeline" label="24 months" title="Quarter by quarter" />
      <ol class="tl">
        {
          timeline.map((q) => (
            <li>
              <div class="row" style="gap: 0.55rem; margin-bottom: 0.35rem">
                <span class="chip chip-signal">{q.q}</span>
                <span class="tag">{q.months}</span>
              </div>
              <h3 style="margin-bottom: 0.35rem">{q.theme}</h3>
              <p class="small muted" style="margin: 0 0 0.5rem; max-width: 80ch">{q.focus}</p>
              <p class="tiny" style="margin: 0; color: var(--lime); font-family: var(--mono)">→ {q.output}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ────────────────────────────────────────────────────────── cadence -->
    <section>
      <SectionHead
        label="Operating rhythm"
        title="The machine underneath the milestones"
        note="Certifications are outcomes. This is the thing that produces them — and the thing to protect on the weeks when work runs long."
      />
      <div class="tscroll" data-reveal>
        <table>
          <thead><tr><th>Rhythm</th><th>Commitment</th><th>What happens</th></tr></thead>
          <tbody>
            {cadence.map((c) => (
              <tr>
                <td><b>{c.rhythm}</b></td>
                <td class="mono tiny dim nowrap">{c.commitment}</td>
                <td class="muted">{c.item}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ──────────────────────────────────────────────────────────── entry -->
    <section>
      <div class="card spot" data-reveal style="border-color: var(--signal-line)">
        <div class="tag tag-signal" style="margin-bottom: 0.7rem">Start here</div>
        <h2 style="margin-bottom: 1.2rem">Three ways in</h2>
        <div class="grid g3 gap" style="gap: 1.4rem; margin-bottom: 1.6rem">
          <div>
            <h4 style="margin-bottom: 0.35rem">Hiring</h4>
            <p class="small muted" style="margin: 0">
              <a href={`${base}/experience`} style="color: var(--signal)">Experience</a> — {yearsExperience} years,
              field record, credentials. Then <a href={`${base}/agentic`} style="color: var(--signal)">what I've built</a>.
            </p>
          </div>
          <div>
            <h4 style="margin-bottom: 0.35rem">Curious about the plan</h4>
            <p class="small muted" style="margin: 0">
              <a href={`${base}/recommendations`} style="color: var(--signal)">The 13 recommendations</a> first —
              they explain why the roadmap is shaped the way it is.
            </p>
          </div>
          <div>
            <h4 style="margin-bottom: 0.35rem">Here to use it</h4>
            <p class="small muted" style="margin: 0">
              <a href={`${base}/roadmap`} style="color: var(--signal)">The roadmap</a> and
              <a href={`${base}/labs`} style="color: var(--signal)"> {totalRooms} mapped labs</a> are free.
              Fork the repo and swap the data files.
            </p>
          </div>
        </div>
        <p class="tiny dim" style="margin: 0">Press <kbd>⌘</kbd><kbd>K</kbd> to search everything on this site.</p>
      </div>
    </section>
  </div>

  <div hidden aria-hidden="true">
    {
      tracks.flatMap((t) =>
        t.phases.flatMap((p) =>
          p.items.map((i) => (
            <input type="checkbox" data-key={itemKey(t.id, p.id, i.title)}
                   data-group={`site.all track.${t.id}`} data-weight={i.weight ?? 1} tabindex="-1" />
          )),
        ),
      )
    }
  </div>
</Base>
