---
import Base from '../../layouts/Base.astro';
import TrackCard from '../../components/TrackCard.astro';
import ProgressPanel from '../../components/ProgressPanel.astro';
import SectionHead from '../../components/SectionHead.astro';
import { tracks, timeline } from '../../data/roadmap';
import { countItems, itemKey } from '../../data/types';
import { yearsWord } from '../../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const totalMilestones = tracks.reduce((n, t) => n + countItems(t), 0);
---

<Base
  title="Roadmap"
  eyebrow="The checklist"
  heading="The roadmap"
  lede={`${totalMilestones} milestones across four tracks. Each one names the artifact it has to produce — tick nothing you cannot link to. Progress saves in your browser, so export a backup occasionally.`}
>
  <div class="wrap stack-lg">
    <section>
      <div class="grid g4 gap">
        {tracks.map((t) => <TrackCard track={t} />)}
      </div>
    </section>

    <section>
      <SectionHead
        id="starting-position"
        title="Starting position — this is not a blank slate"
        note={`The phase windows below are written for someone beginning from zero. I am not. ${yearsWord[0].toUpperCase()}${yearsWord.slice(1)} years of carrier network and service operations, plus CEH and Cisco CyberOps, already cover a meaningful slice of the plan — and pretending otherwise would waste a year.`}
      />
      <div class="grid g2 gap">
        <div class="note-box ok">
          <h4 style="margin: 0 0 0.5rem">Already covered — do not re-study</h4>
          <ul class="small" style="margin: 0">
            <li><b>Networking fundamentals (Foundations + Track 2 phase 1).</b> OSI/TCP-IP, routing, fibre, Metro-E, IP core, DWDM — this is the day job, at carrier scale, across four regions.</li>
            <li><b>Incident and escalation discipline.</b> Service assurance, SLA ownership, root-cause analysis on recurring faults. Most SOC candidates learn this from a course; it is over a decade of my actual work.</li>
            <li><b>Security fundamentals.</b> CEH (Mastery, 2026) and Cisco CyberOps Associate (2021) already clear most of what Security+ and ISC2 CC teach.</li>
            <li><b>Team leadership and stakeholder work.</b> Led branch technical teams, helpdesk operations, and vendor coordination — the part junior candidates cannot fake.</li>
          </ul>
        </div>
        <div class="note-box warn">
          <h4 style="margin: 0 0 0.5rem">The actual gaps — where the time goes</h4>
          <ul class="small" style="margin: 0">
            <li><b>Hands-on offensive and defensive practice.</b> CEH is multiple-choice. The gap is demonstrable practical skill: the lab track, a practical credential, published writeups.</li>
            <li><b>Code and automation.</b> Python, Git, IaC, CI/CD. Operations experience without automation experience is the single biggest limiter on international roles.</li>
            <li><b>The entire AI track.</b> Genuinely from zero, and the fastest-moving opportunity on this site.</li>
            <li><b>Public evidence.</b> More than a decade of strong work that exists only on a CV. Nothing is searchable, nothing is verifiable by a stranger. This is the most urgent gap of the four.</li>
            <li><b>English to C1.</b> IELTS 6.5 today; 7.0+ is the threshold for several visa routes.</li>
          </ul>
        </div>
      </div>

      <div class="card" style="margin-top: 1rem; border-left: 3px solid var(--accent)">
        <h4 style="margin: 0 0 0.5rem">How that changes the plan</h4>
        <p class="small" style="margin: 0 0 0.6rem; max-width: 92ch">
          Compress the first two quarters into roughly one. Skip ISC2 CC and treat Security+ as optional
          paperwork rather than a learning goal — CEH already occupies that slot on a CV. Start the lab
          track and the Python/automation work immediately and in parallel, and bring the hard practical
          credential forward from month 13 to around month 8.
        </p>
        <p class="small muted" style="margin: 0; max-width: 92ch">
          One credential worth checking early: <b>CISSP requires five years of paid experience in two of
          its eight domains</b>. Carrier network operations maps cleanly onto Communication &amp; Network
          Security, and service assurance arguably onto Security Operations. That requirement may already
          be satisfied — which would make CISSP a near-term target rather than a year-three one.
        </p>
      </div>
    </section>

    <section><ProgressPanel /></section>

    <section>
      <SectionHead
        title="Read this before you start"
        note="Three warnings that determine whether this plan produces a job or a very long list of half-finished courses."
      />
      <div class="grid g3 gap">
        <div class="note-box warn">
          <h4 style="margin: 0 0 0.3rem">Do not run three tracks in parallel</h4>
          <p class="small" style="margin: 0">
            Equal effort across three fields produces a plausible junior in all three and a credible
            candidate for none. Pick one primary — roughly 70% of your hours — and let the other two
            make you unusual rather than employable.
            <a href={`${base}/recommendations#rec-1`}>Recommendation 1 →</a>
          </p>
        </div>
        <div class="note-box warn">
          <h4 style="margin: 0 0 0.3rem">Foundations is not optional</h4>
          <p class="small" style="margin: 0">
            It is the phase most self-taught candidates skip and the one that reappears as "failed the
            practical" three rounds later. Three months, properly. All three specialist tracks assume it.
          </p>
        </div>
        <div class="note-box warn">
          <h4 style="margin: 0 0 0.3rem">Plan for month seven</h4>
          <p class="small" style="margin: 0">
            Almost everyone stalls between month six and nine, when the material gets harder and no job
            has appeared yet. Decide your minimum viable week now — one lab and one paragraph is fine.
            <a href={`${base}/recommendations#rec-12`}>Recommendation 12 →</a>
          </p>
        </div>
      </div>
    </section>

    <section>
      <SectionHead title="Track summaries" />
      <div class="stack">
        {
          tracks.map((t) => (
            <div class="card bordered">
              <div class="between" style="align-items: flex-start">
                <div style="flex: 1; min-width: 280px">
                  <h3 style="margin: 0 0 0.4rem"><a href={`${base}/roadmap/${t.slug}`}>{t.title}</a></h3>
                  <p class="small muted" style="margin: 0 0 0.7rem; max-width: 82ch">{t.summary}</p>
                  <p class="small" style="margin: 0 0 0.6rem; max-width: 82ch">
                    <b class="dim tiny" style="text-transform: uppercase; letter-spacing: 0.05em">Market note</b><br />
                    <span class="muted">{t.marketNote}</span>
                  </p>
                  <div class="row">
                    {t.roles.map((r) => <span class="tok">{r}</span>)}
                  </div>
                </div>
                <div style="min-width: 170px">
                  <div class="figure" data-figure-for={`track.${t.id}`}>—</div>
                  <div class="bar thick" style="margin-top: 0.4rem" data-bar-for={`track.${t.id}`}><span></span></div>
                  <p class="tiny dim" style="margin: 0.5rem 0 0">
                    {t.phases.length} phases · {countItems(t)} milestones
                  </p>
                  <a class="btn btn-sm" style="margin-top: 0.6rem" href={`${base}/roadmap/${t.slug}`}>Open →</a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <SectionHead
        id="timeline"
        title="Quarter-by-quarter plan"
        note="Assumes starting from zero at roughly 15 hours a week."
      />
      <ol class="tl">
        {
          timeline.map((q) => (
            <li>
              <div class="row" style="gap: 0.5rem; margin-bottom: 0.2rem">
                <span class="chip chip-signal">{q.q}</span>
                <span class="tiny dim mono">{q.months}</span>
              </div>
              <h3 style="margin: 0 0 0.3rem">{q.theme}</h3>
              <p class="small muted" style="margin: 0 0 0.45rem; max-width: 82ch">{q.focus}</p>
              <p class="tiny" style="margin: 0; color: var(--good)"><b>Output:</b> {q.output}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <div hidden aria-hidden="true">
    {
      tracks.flatMap((t) =>
        t.phases.flatMap((p) =>
          p.items.map((i) => (
            <input
              type="checkbox"
              data-key={itemKey(t.id, p.id, i.title)}
              data-group={`site.all track.${t.id}`}
              data-weight={i.weight ?? 1}
              tabindex="-1"
            />
          )),
        ),
      )
    }
  </div>
</Base>
