---
/**
 * Full-bleed blurred background. Each slot resolves to an optimised photo from
 * src/assets/backgrounds/ when one exists, otherwise to its gradient fallback.
 * Every slot is exposed as CSS variables (--bg-<slot>, --scrim-<slot>,
 * --scrim-sharp-<slot>) so the client script can crossfade between them
 * without knowing file names.
 *
 * The scrim is measured per photo at build time: the photo is blurred the way
 * the page blurs it, its brightest area is found, and the scrim is set to the
 * lightest value that still keeps every text colour above WCAG AA over that
 * area. Dark photos stay visible; bright ones get darkened more. Replacing a
 * photo re-measures it automatically. Pages that ask for a sharp background
 * (the console home screen) blur far less, so they get their own measurement:
 * less blur leaves brighter spots, which need a stronger scrim.
 *
 * The element persists across View Transitions, so moving between pages
 * crossfades the background instead of flashing.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { backgrounds, bgKeys, type BgKey } from '../data/backgrounds';

interface Props { current: BgKey; sharp?: boolean }
const { current, sharp = false } = Astro.props;

// Keep in step with --blur in global.css.
const BLUR = 16, SHARP_BLUR = 5;

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/backgrounds/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);

const FALLBACK_SCRIM = 0.8;   // used for gradients, and if measuring fails
const MIN_SCRIM = 0.55;       // keeps the calm, dark look even for dark photos

// WCAG relative luminance and contrast.
const lin = (c: number) => ((c /= 255) <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
const lum = ([r, g, b]: number[]) => 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
const contrast = (a: number[], b: number[]) => {
  const [hi, lo] = [lum(a), lum(b)].sort((x, y) => y - x);
  return (hi + 0.05) / (lo + 0.05);
};
const mix = (fg: number[], alpha: number, bg: number[]) => fg.map((c, i) => c * alpha + bg[i] * (1 - alpha));

// Must match the tokens in global.css.
const BASE = [6, 8, 14], PANEL = [14, 17, 24], PANEL_ALPHA = 0.72;
const SMALL_TEXT = [174, 181, 193], ACCENT = [140, 188, 255];

async function measureScrim(file: string, blurPx: number): Promise<number> {
  try {
    const sharpLib = (await import('sharp')).default;
    // Blur as the page does: blurPx over a ~1600px-wide cover image is blurPx/10 at 160px.
    const { data, info } = await sharpLib(file).resize(160).blur(Math.max(0.3, blurPx / 10)).raw().toBuffer({ resolveWithObject: true });
    let brightest = [0, 0, 0];
    for (let i = 0; i < data.length; i += info.channels) {
      const px = [data[i], data[i + 1], data[i + 2]];
      if (lum(px) > lum(brightest)) brightest = px;
    }
    for (let a = MIN_SCRIM; a <= 0.95; a += 0.01) {
      const page = mix(BASE, a, brightest);
      const card = mix(PANEL, PANEL_ALPHA, page);
      // 4.6 rather than 4.5 leaves a margin for the blur approximation.
      if (Math.min(contrast(SMALL_TEXT, page), contrast(ACCENT, page), contrast(SMALL_TEXT, card)) >= 4.6) {
        return Math.round((a + 0.02) * 100) / 100;
      }
    }
    return 0.95;
  } catch {
    return FALLBACK_SCRIM;
  }
}

// Small source on purpose: the image is blurred by 16px, so 960px wide
// is plenty and keeps each background well under 150KB.
const vars: string[] = [];
for (const key of bgKeys) {
  const match = Object.entries(files).find(([p]) => p.split('/').pop()!.replace(/\.\w+$/, '') === key);
  if (match) {
    const img = await getImage({ src: match[1].default, width: 960, format: 'webp', quality: 60 });
    // Builds run from the project root; the glob key gives the file name.
    const root: string = (globalThis as any).process?.cwd?.() ?? '.';
    const source = `${root}/src/assets/backgrounds/${match[0].split('/').pop()}`;
    vars.push(
      `--bg-${key}: url("${img.src}")`,
      `--scrim-${key}: ${await measureScrim(source, BLUR)}`,
      `--scrim-sharp-${key}: ${await measureScrim(source, SHARP_BLUR)}`,
    );
  } else {
    vars.push(`--bg-${key}: ${backgrounds[key].fallback}`, `--scrim-${key}: ${FALLBACK_SCRIM}`, `--scrim-sharp-${key}: ${FALLBACK_SCRIM}`);
  }
}
---

<!-- Slot variables live on :root so other elements (the home-screen icons) can show the same photos. -->
<style is:inline set:html={`:root { ${vars.join('; ')}; }`}></style>
<div class="backdrop" style={`--scrim: var(--scrim-${sharp ? 'sharp-' : ''}${current})`} data-backdrop data-current={current} data-sharp={sharp ? 'true' : undefined} transition:persist="backdrop" aria-hidden="true">
  <div class="backdrop-layer is-on" style={`background-image: var(--bg-${current})`}></div>
  <div class="backdrop-layer"></div>
  <div class="backdrop-scrim"></div>
</div>
