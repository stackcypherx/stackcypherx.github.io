---
/** Export / import / reset for locally stored progress. */
---

<div class="panel" data-reveal>
  <div class="between" style="align-items: flex-start">
    <div>
      <div class="tag tag-signal" style="margin-bottom: 0.4rem">Local state</div>
      <h4 style="margin: 0 0 0.3rem">Progress lives in this browser</h4>
      <p class="small muted" style="margin: 0; max-width: 58ch">
        Checkboxes persist to <code>localStorage</code> — no account, no server, nothing leaves the
        device. Which also means clearing site data or switching machine wipes it, so export
        occasionally.
      </p>
    </div>
    <div class="row">
      <button class="btn btn-sm" data-progress-export>Export</button>
      <button class="btn btn-sm" data-progress-import>Import</button>
      <button class="btn btn-sm" data-progress-reset>Reset all progress</button>
    </div>
  </div>
  <p class="small" style="margin: 0.8rem 0 0; color: var(--good); min-height: 1.2em" data-progress-status aria-live="polite"></p>
</div>
