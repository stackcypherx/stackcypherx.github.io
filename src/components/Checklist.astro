---
import type { Phase } from '../data/types';
import { itemKey } from '../data/types';

interface Props {
  trackId: string;
  phase: Phase;
  groups?: string[];
}

const { trackId, phase, groups = [] } = Astro.props;
const phaseGroup = `${trackId}.${phase.id}`;
const allGroups = [phaseGroup, ...groups].join(' ');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolve = (u: string) => (u.startsWith('http') ? u : `${base}${u}`);
const kindChip: Record<string, string> = {
  cert: 'chip-violet', lab: 'chip-signal', project: 'chip-amber',
  signal: 'chip-rose', habit: 'chip-lime', skill: '',
};
---

<section class="phase" id={phaseGroup}>
  <header class="phase-hd">
    <div class="row" style="gap: 0.55rem">
      <span class="chip chip-signal">{phase.window}</span>
      <span class="figure" data-figure-for={phaseGroup} data-figure-mode="count"></span>
    </div>
    <h3>{phase.title}</h3>
    <p class="small muted" style="max-width: 82ch">{phase.goal}</p>
    <div class="bar" style="margin-top: 0.9rem" data-bar-for={phaseGroup}><span></span></div>
    <p class="exit"><b>Done when:</b> {phase.exit}</p>
  </header>

  <ul class="checks">
    {
      phase.items.map((item) => {
        const key = itemKey(trackId, phase.id, item.title);
        return (
          <li class="check" id={key}>
            <label class="hit">
              <input
                type="checkbox"
                class="box"
                data-key={key}
                data-group={allGroups}
                data-weight={item.weight ?? 1}
                id={`cb-${key}`}
              />
            </label>
            <div>
              <div class="row" style="gap: 0.5rem; align-items: baseline">
                <label class="check-t" for={`cb-${key}`}>{item.title}</label>
                <span class={`chip ${kindChip[item.kind] ?? ''}`}>{item.kind}</span>
              </div>
              {item.detail && <div class="check-d">{item.detail}</div>}
              {item.evidence && (
                <div class="check-e"><b>Evidence</b><span>{item.evidence}</span></div>
              )}
              {item.links && item.links.length > 0 && (
                <div class="check-l">
                  {item.links.map((l) => (
                    <a href={resolve(l.url)} rel={l.url.startsWith('http') ? 'noopener' : undefined}>{l.label}{l.url.startsWith('http') && ' ↗'}</a>
                  ))}
                </div>
              )}
            </div>
          </li>
        );
      })
    }
  </ul>
</section>
