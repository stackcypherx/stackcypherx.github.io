---
import type { Track } from '../data/types';
import { countItems } from '../data/types';
import { tracks } from '../data/roadmap';

interface Props { track: Track }
const { track } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// A numbered index reads as a contents list rather than an icon grid.
const n = String(tracks.findIndex((t) => t.id === track.id) + 1).padStart(2, '0');
---

<a class="card card-i" href={`${base}/plan/roadmap/${track.slug}`}
   style="display: flex; flex-direction: column; gap: 0.7rem">
  <div class="between" style="align-items: baseline">
    <span class="mono tiny" style="color: var(--accent)">{n}</span>
    <span class="figure" data-figure-for={`track.${track.id}`} data-figure-mode="pct"></span>
  </div>
  <h3 style="margin: 0">{track.short}</h3>
  <p class="small muted" style="flex: 1; margin: 0">{track.tagline}</p>
  <div class="bar" data-bar-for={`track.${track.id}`}><span></span></div>
  <div class="tag">{track.phases.length} phases · {countItems(track)} milestones</div>
</a>
