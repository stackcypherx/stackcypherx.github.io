---
interface Props {
  id?: string;
  label?: string;
  title: string;
  note?: string;
}
const { id, label, title, note } = Astro.props;
---

<header class="sec-head" id={id}>
  {label && <div class="tag tag-signal">{label}</div>}
  <h2>{title}</h2>
  {note && <p class="note">{note}</p>}
</header>
