---
import Base from './Base.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    date: string;
    track?: string;
    tags?: string[];
    lang?: string;
  };
}

const { frontmatter: fm } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dateLabel = new Date(fm.date).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base title={fm.title} description={fm.description}>
  <div class="wrap">
    <article class="narrow">
      <p class="small" style="margin-bottom: 1.5rem">
        <a href={`${base}/writing`}>← All writing</a>
      </p>

      <div class="row" style="gap: 0.5rem; margin-bottom: 0.7rem">
        <time class="tiny dim mono" datetime={fm.date}>{dateLabel}</time>
        {fm.track && <span class="chip chip-signal">{fm.track}</span>}
        {fm.lang && fm.lang !== 'en' && <span class="chip">{fm.lang.toUpperCase()}</span>}
      </div>

      <h1 style="margin-bottom: 0.6rem">{fm.title}</h1>
      {fm.description && <p class="lede" style="margin-bottom: 1.2rem">{fm.description}</p>}

      {
        fm.tags && fm.tags.length > 0 && (
          <div class="row" style="margin-bottom: 2rem">
            {fm.tags.map((t) => <span class="tok tiny">{t}</span>)}
          </div>
        )
      }

      <hr />

      <div class="prose">
        <slot />
      </div>

      <hr />
      <p class="small dim">
        <a href={`${base}/writing`}>← All writing</a>
      </p>
    </article>
  </div>
</Base>
