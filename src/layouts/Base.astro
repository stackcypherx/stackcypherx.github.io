---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site, nav, planNav, sections } from '../data/site';
import { buildIndex } from '../data/search';
import Backdrop from '../components/Backdrop.astro';
import { backgrounds, type BgKey } from '../data/backgrounds';

interface Props {
  title?: string;
  description?: string;
  /** Renders the standard hero block. */
  heading?: string;
  lede?: string;
  eyebrow?: string;
  /** Use the oversized display type for the heading. */
  display?: boolean;
  /** Background slot; defaults to one chosen from the URL. */
  bg?: BgKey;
  /** Lighter blur so the photo reads clearly (the console home screen). */
  sharpBg?: boolean;
}

const { title, description = site.description, heading, lede, eyebrow, display = false, bg, sharpBg = false } = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : site.title;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => (p.startsWith('http') ? p : `${base}${p}` || '/');
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (p: string) => {
  const target = href(p).replace(/\/$/, '') || '/';
  return current === target || (target !== '/' && current.startsWith(target + '/'));
};
const index = JSON.stringify(buildIndex(base));
const photoCredits = Object.values(backgrounds).flatMap((b) => (b.credit ? [b.credit] : []));

// Each page's background is chosen by what the page is about.
const bgByPath: [string, BgKey][] = [
  ['/plan/roadmap/cybersecurity', 'security'],
  ['/plan/roadmap/network-engineering', 'field'],
  ['/plan/roadmap/ai-agentic', 'work'],
  ['/plan/labs', 'security'],
  ['/plan', 'lab'],
  ['/work', 'work'],
  ['/writing', 'writing'],
];
const pageBg: BgKey = bg ?? bgByPath.find(([p]) => current === href(p) || current.startsWith(href(p) + '/'))?.[1] ?? 'field';
const inPlan = current === href('/plan') || current.startsWith(href('/plan') + '/');
// Track pages live under /plan/roadmap and belong to the Overview entry.
const isHome = current === (href('/').replace(/\/$/, '') || '/');
// Initials stand in for a profile picture: photos stay off the public site.
const initials = site.name.split(' ').filter(Boolean).map((w) => w[0]).slice(0, 2).join('');
const isPlanCurrent = (p: string) =>
  p === '/plan'
    ? current === href('/plan') || current.startsWith(href('/plan/roadmap'))
    : current === href(p) || current.startsWith(href(p) + '/');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#06080e" />
    <link rel="canonical" href={new URL(Astro.url.pathname, site.url).href} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={new URL(Astro.url.pathname, site.url).href} />
    <meta name="twitter:card" content="summary" />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2306080e'/%3E%3Cpath d='M14 46 L32 16 L50 46' stroke='%23f3f5f9' stroke-width='5' fill='none'/%3E%3Cpath d='M22 38 h20' stroke='%238cbcff' stroke-width='5'/%3E%3C/svg%3E"
    />

    <script is:inline>document.documentElement.classList.add('has-js');</script>

    <ClientRouter />
  </head>

  <body>
    <Backdrop current={pageBg} sharp={sharpBg} />
    <header class="hdr">
      <div class="wrap hdr-in">
        <a class="brand" href={href('/')}>
          <span>{site.shortName}</span><span class="brand-sub">{site.role}</span>
        </a>

        <nav class="tabs" aria-label="Sections">
          {sections.map((t) => {
            const on = t.href === '/plan' ? inPlan : !inPlan;
            return (
              <a href={href(t.href)} aria-current={on ? 'true' : undefined}>
                <span class="tab-long">{t.label}</span><span class="tab-short" aria-hidden="true">{t.short}</span>
              </a>
            );
          })}
        </nav>

        <span class="clock" data-clock title="My local time (Makassar, UTC+8)">
          <span class="clock-t" data-clock-time>UTC+8</span><span class="clock-p"> in Makassar</span>
        </span>

        <button class="kbd-btn" data-cmdk-open aria-label="Search">
          <span>⌕</span><span class="lbl">Search</span><kbd>⌘K</kbd>
        </button>

        <a class="avatar" href={href('/about')} aria-label={`About ${site.name}`}>{initials}</a>
      </div>
      {inPlan ? (
        <nav class="subnav" aria-label="Learning plan">
          <div class="wrap subnav-in">
            {planNav.map((n) => (
              <a href={href(n.href)} aria-current={isPlanCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
            ))}
          </div>
        </nav>
      ) : !isHome && (
        <nav class="subnav" aria-label="Portfolio">
          <div class="wrap subnav-in">
            {nav.map((n) => (
              <a href={href(n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
            ))}
          </div>
        </nav>
      )}
    </header>

    <main data-page-bg={pageBg} data-page-sharp={sharpBg ? 'true' : undefined}>
      {heading && (
        <section class="hero">
          <div class="wrap hero-in">
            {eyebrow && <div class="eyebrow">{eyebrow}</div>}
            <h1 class={display ? 'display' : ''}>{heading}</h1>
            {lede && <p class="lede" style="margin-top: 1.3rem">{lede}</p>}
            <slot name="hero-extra" />
          </div>
        </section>
      )}
      <slot />
    </main>

    <footer class="ftr">
      <div class="wrap">
        <div class="between" style="align-items: flex-start">
          <div>
            <div style="margin-bottom: 0.5rem"><b style="font-size: 1.05rem; font-weight: 500">{site.name}</b></div>
            <p class="small muted" style="max-width: 46ch">{site.tagline}</p>
          </div>

          <div>
            <div class="tag" style="margin-bottom: 0.6rem">Elsewhere</div>
            <div class="row small">
              {site.links.github && <a href={site.links.github}>GitHub</a>}
              {site.links.linkedin && <a href={site.links.linkedin}>LinkedIn</a>}
              {site.links.tryhackme && <a href={site.links.tryhackme}>TryHackMe</a>}
              {site.links.email && <a href={`mailto:${site.links.email}`}>Email</a>}
            </div>
          </div>

          <div>
            <div class="tag" style="margin-bottom: 0.6rem">Colophon</div>
            <p class="tiny dim" style="max-width: 34ch">
              Astro · hand-written CSS · no trackers, no analytics, no cookies.
              <a href={site.repo} > Source</a>.
            </p>
          </div>
        </div>

        <p class="tiny dim" style="margin-top: 2.2rem; max-width: 84ch; border-top: 1px solid var(--rule); padding-top: 1.2rem">
          Roadmap research current as of September 2026. Certification costs, exam codes, visa
          thresholds and platform pricing change, so verify against the official source before booking
          or applying. Nothing here is immigration or financial advice.
        </p>
        {photoCredits.length > 0 && (
          <p class="tiny dim" style="margin-top: 0.8rem; max-width: 84ch">
            Background photos:{' '}
            {photoCredits.map((c, i) => (
              <>{i > 0 && ', '}<a href={c.url}>{c.by}</a> ({c.source})</>
            ))}.
          </p>
        )}
      </div>
    </footer>

    <!-- command palette -->
    <div class="cmdk" data-cmdk role="dialog" aria-modal="true" aria-label="Search">
      <div class="cmdk-box">
        <input class="cmdk-in" data-cmdk-input type="text" placeholder="Search milestones, certs, labs, experience…" autocomplete="off" spellcheck="false" />
        <div class="cmdk-list" data-cmdk-list role="listbox"></div>
        <div class="cmdk-foot">
          <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
          <span><kbd>↵</kbd> open</span>
          <span><kbd>esc</kbd> close</span>
        </div>
      </div>
    </div>

    <script id="search-index" type="application/json" is:inline set:html={index}></script>
    <script src="../scripts/ui.ts"></script>
  </body>
</html>
