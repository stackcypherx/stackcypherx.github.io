---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site, nav } from '../data/site';
import { buildIndex } from '../data/search';

interface Props {
  title?: string;
  description?: string;
  /** Renders the standard hero block. */
  heading?: string;
  lede?: string;
  eyebrow?: string;
  /** Show the animated topology canvas behind the hero. */
  canvas?: boolean;
  /** Use the oversized display type for the heading. */
  display?: boolean;
}

const { title, description = site.description, heading, lede, eyebrow, canvas = false, display = false } = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : site.title;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => (p.startsWith('http') ? p : `${base}${p}` || '/');
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (p: string) => {
  const target = href(p).replace(/\/$/, '') || '/';
  return current === target || (target !== '/' && current.startsWith(target + '/'));
};
const index = JSON.stringify(buildIndex(base));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#06080c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fcfcfd" media="(prefers-color-scheme: light)" />
    <link rel="canonical" href={new URL(Astro.url.pathname, site.url).href} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={new URL(Astro.url.pathname, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%2306080c'/%3E%3Ccircle cx='20' cy='22' r='4' fill='%232ee6c5'/%3E%3Ccircle cx='44' cy='32' r='4' fill='%232ee6c5'/%3E%3Ccircle cx='24' cy='46' r='4' fill='%232ee6c5'/%3E%3Cpath d='M20 22 L44 32 L24 46 Z' stroke='%232ee6c5' stroke-width='2' fill='none' opacity='.45'/%3E%3C/svg%3E"
    />

    <script is:inline>
      (() => {
        document.documentElement.classList.add('has-js');
        try {
          const s = localStorage.getItem('theme');
          if (s === 'dark' || s === 'light') document.documentElement.setAttribute('data-theme', s);
        } catch {}
      })();
    </script>

    <ClientRouter />
  </head>

  <body>
    <header class="hdr">
      <div class="wrap hdr-in">
        <a class="brand" href={href('/')}>
          <span class="brand-dot"></span>
          <span>{site.shortName}<span class="brand-sub"> / {site.role}</span></span>
        </a>

        <button class="icon-btn burger" data-burger aria-label="Menu" aria-expanded="false">☰</button>

        <nav class="nav" data-nav aria-label="Primary">
          {nav.map((n) => (
            <a href={href(n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>

        <button class="kbd-btn" data-cmdk-open aria-label="Search">
          <span>⌕</span><span class="lbl">Search</span><kbd>⌘K</kbd>
        </button>

        <button class="icon-btn" data-theme-toggle aria-label="Toggle theme">
          <span data-theme-icon>◐</span>
        </button>
      </div>
    </header>

    <main>
      {heading && (
        <section class="hero">
          {canvas && <canvas class="hero-canvas" data-network aria-hidden="true"></canvas>}
          <div class="wrap hero-in">
            {eyebrow && <div class="eyebrow" data-reveal>{eyebrow}</div>}
            <h1 class={display ? 'display' : ''} data-reveal="60">{heading}</h1>
            {lede && <p class="lede" style="margin-top: 1.3rem" data-reveal="140">{lede}</p>}
            <slot name="hero-extra" />
          </div>
        </section>
      )}
      <slot />
    </main>

    <footer class="ftr">
      <div class="wrap">
        <div class="between" style="align-items: flex-start">
          <div>
            <div class="row" style="gap: 0.5rem; margin-bottom: 0.5rem">
              <span class="brand-dot"></span>
              <b>{site.name}</b>
            </div>
            <p class="small muted" style="max-width: 46ch">{site.tagline}</p>
          </div>

          <div>
            <div class="tag" style="margin-bottom: 0.6rem">Elsewhere</div>
            <div class="row small">
              {site.links.github && <a href={site.links.github}>GitHub</a>}
              {site.links.linkedin && <a href={site.links.linkedin}>LinkedIn</a>}
              {site.links.tryhackme && <a href={site.links.tryhackme}>TryHackMe</a>}
              {site.links.email && <a href={`mailto:${site.links.email}`}>Email</a>}
            </div>
          </div>

          <div>
            <div class="tag" style="margin-bottom: 0.6rem">Colophon</div>
            <p class="tiny dim" style="max-width: 34ch">
              Astro · hand-written CSS · canvas · no trackers, no analytics, no cookies.
              <a href={site.repo} style="color: var(--signal)"> Source</a>.
            </p>
          </div>
        </div>

        <p class="tiny dim" style="margin-top: 2.2rem; max-width: 84ch; border-top: 1px solid var(--line); padding-top: 1.2rem">
          Roadmap research current as of September 2026. Certification costs, exam codes, visa
          thresholds and platform pricing change — verify against the official source before booking
          or applying. Nothing here is immigration or financial advice.
        </p>
      </div>
    </footer>

    <!-- command palette -->
    <div class="cmdk" data-cmdk role="dialog" aria-modal="true" aria-label="Search">
      <div class="cmdk-box">
        <input class="cmdk-in" data-cmdk-input type="text" placeholder="Search milestones, certs, labs, experience…" autocomplete="off" spellcheck="false" />
        <div class="cmdk-list" data-cmdk-list role="listbox"></div>
        <div class="cmdk-foot">
          <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
          <span><kbd>↵</kbd> open</span>
          <span><kbd>esc</kbd> close</span>
        </div>
      </div>
    </div>

    <script id="search-index" type="application/json" is:inline set:html={index}></script>
    <script src="../scripts/ui.ts"></script>
  </body>
</html>
